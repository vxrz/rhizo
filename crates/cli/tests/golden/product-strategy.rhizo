    - "Risks" {
        - "Scope creep" class="risk"
        - "Mermaid parity expectations" class="risk"
    }
    - "Go to market" {
        - "Open source core"
        - "Pro: collaboration"
        - "Templates gallery"
    }
    - "Metrics" {
