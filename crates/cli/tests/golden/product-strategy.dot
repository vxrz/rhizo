digraph "Product strategy 2027" {
    graph [rankdir=LR, fontname="Helvetica", nodesep=0.4, ranksep=0.5, bgcolor="#ffffff"];
    label="Product strategy 2027"; labelloc=t; fontsize=18;
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#d4d4d8", fontcolor="#18181b", fontname="Helvetica", fontsize=12, margin="0.2,0.1"];
    edge [color="#a1a1aa", fontname="Helvetica", fontsize=10, fontcolor="#71717a"];
    product_strategy [label="Product strategy", style="rounded,filled"];
    customers [label="Customers", style="rounded,filled"];
    indie_researchers [label="Indie researchers", style="rounded,filled"];
