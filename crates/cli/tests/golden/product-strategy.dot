    text_and_canvas_one_document [label="Text and canvas, one document", style="rounded,filled"];
    exports_every_format [label="Exports every format", style="rounded,filled", fillcolor="#dcfce7", color="#22c55e"];
    native_speed [label="Native speed", style="rounded,filled"];
    risks [label="Risks", style="rounded,filled"];
    scope_creep [label="Scope creep", style="rounded,filled", fillcolor="#fee2e2", color="#ef4444"];
    mermaid_parity_expectations [label="Mermaid parity expectations", style="rounded,filled", fillcolor="#fee2e2", color="#ef4444"];
    go_to_market [label="Go to market", style="rounded,filled"];
    open_source_core [label="Open source core", style="rounded,filled"];
    pro_collaboration [label="Pro: collaboration", style="rounded,filled"];
    templates_gallery [label="Templates gallery", style="rounded,filled"];
    metrics [label="Metrics", style="rounded,filled"];
    weekly_active_docs [label="Weekly active docs", style="rounded,filled"];
    exports_per_user [label="Exports per user", style="rounded,filled"];
    product_strategy -> customers [arrowhead=none];
    product_strategy -> differentiation [arrowhead=none];
    product_strategy -> risks [arrowhead=none];
    product_strategy -> go_to_market [arrowhead=none];
    product_strategy -> metrics [arrowhead=none];
    customers -> indie_researchers [arrowhead=none];
    customers -> design_teams [arrowhead=none];
    customers -> engineering_orgs [arrowhead=none];
    engineering_orgs -> architecture_docs [arrowhead=none];
    engineering_orgs -> onboarding [arrowhead=none];
    differentiation -> text_and_canvas_one_document [arrowhead=none];
    differentiation -> exports_every_format [arrowhead=none];
    differentiation -> native_speed [arrowhead=none];
    risks -> scope_creep [arrowhead=none];
    risks -> mermaid_parity_expectations [arrowhead=none];
    go_to_market -> open_source_core [arrowhead=none];
    go_to_market -> pro_collaboration [arrowhead=none];
    go_to_market -> templates_gallery [arrowhead=none];
