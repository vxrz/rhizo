{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/aws.rds.postgres.json",
  "title": "RDS Postgres",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engine-version": {
      "type": "string",
      "pattern": "^[0-9]{2}(\\.[0-9]+)?$",
      "default": "17",
      "description": "PostgreSQL major version, or major.minor"
    },
    "instance-class": { "type": "string", "pattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$", "default": "db.t4g.micro" },
    "storage-gb": { "type": "integer", "minimum": 20, "maximum": 65536, "default": 20 },
    "multi-az": { "type": "boolean", "default": true },
    "backup-days": { "type": "integer", "minimum": 1, "maximum": 35, "default": 7 },
    "deletion-protection": { "type": "boolean", "default": true },
    "database": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}$",
      "description": "Initial database name (default: the node id with underscores)"
    },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Holds sensitive data: needs a customer-managed KMS key (a dependency edge to an aws.kms.key)"
    }
  }
}
