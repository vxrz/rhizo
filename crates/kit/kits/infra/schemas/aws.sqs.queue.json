{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/aws.sqs.queue.json",
  "title": "SQS queue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fifo": { "type": "boolean", "default": false },
    "retention-s": { "type": "integer", "minimum": 60, "maximum": 1209600, "default": 345600 },
    "visibility-timeout-s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 43200,
      "default": 30,
      "description": "At least the timeout of a function it triggers"
    },
    "dlq": { "type": "boolean", "default": true, "description": "Move messages that keep failing to a dead-letter queue" },
    "max-receives": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 5 },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Holds sensitive data: needs a customer-managed KMS key (a dependency edge to an aws.kms.key)"
    }
  }
}
