{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/infra.function.json",
  "title": "Function",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtime": {
      "type": "string",
      "pattern": "^(nodejs[0-9]+\\.x|python3\\.[0-9]+|java[0-9]+|dotnet[0-9]+|ruby[0-9]\\.[0-9]+|provided\\.al20[0-9]{2})$",
      "default": "nodejs22.x"
    },
    "handler": {
      "type": "string",
      "default": "index.handler"
    },
    "memory-mb": {
      "type": "integer",
      "minimum": 128,
      "maximum": 10240,
      "default": 256
    },
    "timeout-s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900,
      "default": 10
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variables (no secrets: use Secrets Manager)"
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ],
          "default": "arm64"
        },
        "log-retention-days": {
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ],
          "default": 30
        }
      },
      "description": "Settings only AWS has; used when the environment's cloud is aws"
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance-memory-mb": {
          "enum": [
            512,
            2048,
            4096
          ],
          "description": "Flex Consumption instance memory (default: the smallest size that holds memory-mb)"
        }
      },
      "description": "Settings only Azure has; used when the environment's cloud is azure"
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max-instance-count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Most instances Cloud Run runs at once"
        }
      },
      "description": "Settings only Google Cloud has; used when the environment's cloud is gcp"
    },
    "tf-type": {
      "$ref": "imported.json#/$defs/tf-type",
      "readOnly": true
    },
    "mode": {
      "$ref": "imported.json#/$defs/mode",
      "readOnly": true
    },
    "name": {
      "$ref": "imported.json#/$defs/name",
      "readOnly": true
    },
    "source": {
      "$ref": "imported.json#/$defs/source",
      "readOnly": true
    },
    "version": {
      "$ref": "imported.json#/$defs/version",
      "readOnly": true
    },
    "body": {
      "$ref": "imported.json#/$defs/body",
      "readOnly": true
    },
    "origin": {
      "$ref": "imported.json#/$defs/origin",
      "readOnly": true
    }
  }
}
