{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/infra.queue.json",
  "title": "Queue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ordered": {
      "type": "boolean",
      "default": false
    },
    "retention-s": {
      "type": "integer",
      "minimum": 60,
      "maximum": 1209600,
      "default": 345600
    },
    "lock-timeout-s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 43200,
      "default": 30,
      "description": "At least the timeout of a function it triggers"
    },
    "dead-letter": {
      "type": "boolean",
      "default": true,
      "description": "Move messages that keep failing to a dead-letter queue"
    },
    "max-deliveries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 5
    },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Holds sensitive data: needs a customer-managed key (a dependency edge to an infra.key)"
    },
    "tf-type": {
      "$ref": "imported.json#/$defs/tf-type",
      "readOnly": true
    },
    "mode": {
      "$ref": "imported.json#/$defs/mode",
      "readOnly": true
    },
    "name": {
      "$ref": "imported.json#/$defs/name",
      "readOnly": true
    },
    "source": {
      "$ref": "imported.json#/$defs/source",
      "readOnly": true
    },
    "version": {
      "$ref": "imported.json#/$defs/version",
      "readOnly": true
    },
    "body": {
      "$ref": "imported.json#/$defs/body",
      "readOnly": true
    },
    "origin": {
      "$ref": "imported.json#/$defs/origin",
      "readOnly": true
    }
  }
}
