{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/aws.lambda.function.json",
  "title": "Lambda function",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtime": {
      "type": "string",
      "pattern": "^(nodejs[0-9]+\\.x|python3\\.[0-9]+|java[0-9]+|dotnet[0-9]+|ruby[0-9]\\.[0-9]+|provided\\.al20[0-9]{2})$",
      "default": "nodejs22.x"
    },
    "handler": { "type": "string", "default": "index.handler" },
    "memory-mb": { "type": "integer", "minimum": 128, "maximum": 10240, "default": 256 },
    "timeout-s": { "type": "integer", "minimum": 1, "maximum": 900, "default": 10 },
    "architecture": { "enum": ["arm64", "x86_64"], "default": "arm64" },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" },
      "description": "Environment variables (no secrets: use Secrets Manager)"
    },
    "log-retention-days": {
      "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653],
      "default": 30
    }
  }
}
