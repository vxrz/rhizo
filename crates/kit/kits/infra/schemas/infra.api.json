{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/infra/0.1/infra.api.json",
  "title": "HTTP API",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cors-origins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://[^/]+|\\*)$"
      },
      "description": "Origins allowed to call the API from a browser"
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[a-z]+-[a-z]+[0-9]+$",
          "description": "Region of the API Gateway gateway (default: the environment's); API Gateway runs in fewer regions than Cloud Run"
        }
      },
      "description": "Settings only Google Cloud has; used when the environment's cloud is gcp"
    },
    "tf-type": {
      "$ref": "imported.json#/$defs/tf-type",
      "readOnly": true
    },
    "mode": {
      "$ref": "imported.json#/$defs/mode",
      "readOnly": true
    },
    "name": {
      "$ref": "imported.json#/$defs/name",
      "readOnly": true
    },
    "source": {
      "$ref": "imported.json#/$defs/source",
      "readOnly": true
    },
    "version": {
      "$ref": "imported.json#/$defs/version",
      "readOnly": true
    },
    "body": {
      "$ref": "imported.json#/$defs/body",
      "readOnly": true
    },
    "origin": {
      "$ref": "imported.json#/$defs/origin",
      "readOnly": true
    }
  }
}
