{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizo.dev/kits/flow/0.1/flow.workflow.json",
  "title": "Workflow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "default": "default",
      "description": "Groups workflows in Serverless Workflow: lowercase letters, digits and dashes"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "default": "0.1.0"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["serverless-workflow", "node-red"] },
      "default": ["serverless-workflow", "node-red"],
      "description": "What to compile to; a step a target cannot express is an error"
    },
    "description": { "type": "string" }
  }
}
